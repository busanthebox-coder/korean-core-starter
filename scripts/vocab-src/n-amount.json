[{"kind": "noun", "hangul": "전부", "english": "all, everything", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["이게 전부예요?", "Is this everything?", "Asking if nothing remains"], ["전부 다 먹었어요.", "I ate all of it.", "전부 with 다 for emphasis"], ["돈을 전부 썼어요.", "I spent all the money.", "Means the whole amount"], ["전부 제 잘못이에요.", "It is all my fault.", "Means entirely or completely"]], "examples": [["숙제를 전부 끝냈어요.", "I finished all the homework.", "Nothing left undone"], ["손님이 전부 떠났어요.", "All the guests left.", "Every single person"], ["이 책을 전부 읽었어요?", "Did you read this whole book?", "The entire book"]], "nuance": "전부 means the whole quantity with nothing left out, and it often pairs with 다 to stress total completeness.", "mistakes": ["Do not confuse 전부 with 대부분, which means most not all."]}, {"kind": "noun", "hangul": "절반", "english": "half", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["사과를 절반 먹었어요.", "I ate half the apple.", "Half of one thing"], ["월급의 절반을 저금해요.", "I save half my salary.", "절반 plus possessive 의"], ["절반은 친구 거예요.", "Half is my friend's.", "절반 as the subject"], ["거의 절반이 끝났어요.", "Almost half is done.", "절반 with 거의 nearly"]], "examples": [["케이크를 절반으로 잘랐어요.", "I cut the cake in half.", "Into two equal parts"], ["학생의 절반이 왔어요.", "Half of the students came.", "Half of a group"], ["절반만 주세요.", "Please give me just half.", "Only half please"]], "nuance": "절반 means one of two equal parts and feels precise, while 반 is the shorter casual word for the same idea.", "mistakes": ["Do not use 절반 for a vague amount, since it means exactly one half."]}, {"kind": "noun", "hangul": "일부", "english": "part, a portion", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["일부 사람만 왔어요.", "Only some people came.", "일부 modifying a noun"], ["돈의 일부를 냈어요.", "I paid part of the money.", "A portion of the total"], ["이건 일부일 뿐이에요.", "This is only a part.", "일부 with 뿐 only"], ["일부는 아직 남았어요.", "Some still remains.", "일부 as the subject"]], "examples": [["회원의 일부가 반대했어요.", "Some of the members opposed.", "A subset of the group"], ["일부 가게는 문을 닫았어요.", "Some shops were closed.", "Not all shops"], ["보고서의 일부만 읽었어요.", "I read only part of the report.", "A small portion"]], "nuance": "일부 means a limited portion of a larger whole and contrasts directly with 전부, the complete amount.", "mistakes": ["Do not say 일부 when you mean 전부, the whole thing."]}, {"kind": "noun", "hangul": "대부분", "english": "most, the majority", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["대부분 집에 있어요.", "Most people are at home.", "대부분 as adverb here"], ["학생의 대부분이 한국인이에요.", "Most students are Korean.", "대부분 with 의 of"], ["대부분은 동의했어요.", "Most agreed.", "대부분 as the subject"], ["시간의 대부분을 썼어요.", "I used most of the time.", "Most of the total"]], "examples": [["대부분의 가게가 비싸요.", "Most of the shops are expensive.", "Nearly all shops"], ["주말에는 대부분 쉬어요.", "On weekends I mostly rest.", "대부분 as usually"], ["대부분 사람은 친절해요.", "Most people are kind.", "The majority of people"]], "nuance": "대부분 means almost all but not quite everything, sitting between 일부 a portion and 전부 the entire whole.", "mistakes": ["Do not treat 대부분 as 전부, since a small part is still excluded."]}, {"kind": "noun", "hangul": "약간", "english": "a little, a bit", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["약간 매워요.", "It is a little spicy.", "약간 as adverb here"], ["소금을 약간 넣었어요.", "I added a little salt.", "A small amount added"], ["약간의 시간이 필요해요.", "I need a little time.", "약간 with 의 of"], ["약간 피곤해요.", "I am a bit tired.", "Softens the meaning slightly"]], "examples": [["커피에 설탕을 약간 넣어요.", "I add a little sugar to coffee.", "Just a small amount"], ["오늘은 약간 추워요.", "Today it is a bit cold.", "Slightly cold weather"], ["약간 다르게 보여요.", "It looks a little different.", "A small difference"]], "nuance": "약간 means a small amount or slight degree, and it softens statements much like the English word a bit.", "mistakes": ["Do not use 약간 for large amounts, since it always means a little."]}, {"kind": "noun", "hangul": "여러", "english": "several, various", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["여러 사람이 왔어요.", "Several people came.", "여러 before a noun"], ["여러 번 말했어요.", "I said it several times.", "여러 with counter 번"], ["여러 나라를 여행했어요.", "I traveled to several countries.", "Various different countries"], ["여러 가지가 있어요.", "There are various kinds.", "여러 with 가지 kinds"]], "examples": [["여러 친구를 만났어요.", "I met several friends.", "More than a few"], ["여러 문제가 생겼어요.", "Several problems came up.", "Multiple separate problems"], ["여러 색깔이 있어요.", "There are various colors.", "Many different colors"]], "nuance": "여러 always stands before a noun to mean several or various, and it cannot be used alone as a subject.", "mistakes": ["Do not use 여러 by itself, since it must modify a following noun."]}, {"kind": "noun", "hangul": "수량", "english": "quantity, amount", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["수량이 부족해요.", "The quantity is not enough.", "수량 as the subject"], ["수량을 확인했어요.", "I checked the quantity.", "Counting the items"], ["수량은 열 개예요.", "The quantity is ten.", "수량 with a number"], ["수량이 많아요.", "The quantity is large.", "A big amount"]], "examples": [["주문 수량을 적어 주세요.", "Please write the order quantity.", "Number of ordered items"], ["재고 수량이 적어요.", "The stock quantity is low.", "Few items in stock"], ["수량을 다시 세어 봤어요.", "I counted the quantity again.", "Recounted the items"]], "nuance": "수량 refers to a countable number of items and appears often in shopping, ordering, and inventory situations.", "mistakes": ["Do not use 수량 for uncountable things like water or feelings."]}, {"kind": "noun", "hangul": "단위", "english": "unit", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["단위가 달라요.", "The unit is different.", "단위 as the subject"], ["무게 단위를 바꿨어요.", "I changed the weight unit.", "Unit of measurement"], ["단위는 킬로그램이에요.", "The unit is kilograms.", "단위 with a value"], ["천 원 단위로 팔아요.", "It sells by thousand won.", "단위 meaning per unit"]], "examples": [["길이 단위는 미터예요.", "The length unit is meters.", "Standard measuring unit"], ["단위를 정확히 쓰세요.", "Use the unit correctly.", "Write units precisely"], ["이 약은 한 알 단위예요.", "This medicine is per pill.", "Counted one pill at a time"]], "nuance": "단위 names a standard measure such as meters or kilograms, and it can also mean a basic counting block.", "mistakes": ["Do not confuse 단위 a unit with 수량, which is the counted amount."]}, {"kind": "noun", "hangul": "두께", "english": "thickness", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["두께가 얇아요.", "The thickness is thin.", "두께 as the subject"], ["종이 두께를 쟀어요.", "I measured the paper thickness.", "How thick it is"], ["두께는 일 센티미터예요.", "The thickness is one centimeter.", "두께 with a value"], ["두께가 두꺼워요.", "The thickness is thick.", "Describes a thick object"]], "examples": [["이 책은 두께가 얇아요.", "This book is thin.", "Small thickness"], ["벽의 두께가 두꺼워요.", "The wall is thick.", "Large thickness"], ["두께가 모두 달라요.", "The thicknesses are all different.", "Varying thickness"]], "nuance": "두께 describes how thick a flat object is, such as paper, a wall, or fabric, measured front to back.", "mistakes": ["Do not use 두께 for height, since 두께 measures thickness only."]}, {"kind": "noun", "hangul": "무게", "english": "weight", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["무게가 무거워요.", "The weight is heavy.", "무게 as the subject"], ["가방 무게를 쟀어요.", "I measured the bag weight.", "How heavy it is"], ["무게는 오 킬로그램이에요.", "The weight is five kilograms.", "무게 with a value"], ["무게가 가벼워요.", "The weight is light.", "Describes a light object"]], "examples": [["이 상자는 무게가 무거워요.", "This box is heavy.", "Large weight"], ["무게를 정확히 재 주세요.", "Please weigh it accurately.", "Measure the weight"], ["짐의 무게가 너무 무거워요.", "The luggage weight is too much.", "Too heavy overall"]], "nuance": "무게 means how heavy something is and pairs with adjectives like 무겁다 heavy and 가볍다 light when described.", "mistakes": ["Do not confuse 무게 weight with 수량, the number of items."]}, {"kind": "noun", "hangul": "길이", "english": "length", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["길이가 길어요.", "The length is long.", "길이 as the subject"], ["치마 길이를 쟀어요.", "I measured the skirt length.", "How long it is"], ["길이는 이 미터예요.", "The length is two meters.", "길이 with a value"], ["길이가 짧아요.", "The length is short.", "Describes a short object"]], "examples": [["이 줄은 길이가 길어요.", "This rope is long.", "Large length"], ["머리 길이를 줄였어요.", "I shortened my hair length.", "Made the hair shorter"], ["책상의 길이를 재 봤어요.", "I measured the desk length.", "Checked how long"]], "nuance": "길이 means how long something is from end to end and works with 길다 long and 짧다 short to describe size.", "mistakes": ["Do not use 길이 for height, since 길이 means horizontal length."]}, {"kind": "noun", "hangul": "높이", "english": "height", "topic": "daily-life", "chapterIds": ["chapter-04"], "grammarIds": ["grammar-particle-eun-neun"], "usage": [["높이가 높아요.", "The height is high.", "높이 as the subject"], ["산의 높이를 쟀어요.", "I measured the mountain height.", "How high it is"], ["높이는 삼 미터예요.", "The height is three meters.", "높이 with a value"], ["높이가 낮아요.", "The height is low.", "Describes a low object"]], "examples": [["이 건물은 높이가 높아요.", "This building is tall.", "Large height"], ["책장의 높이를 재 봤어요.", "I measured the bookshelf height.", "Checked how high"], ["의자 높이를 바꿨어요.", "I changed the chair height.", "Adjusted the height"]], "nuance": "높이 means how high or tall something is from bottom to top and pairs with 높다 high and 낮다 low naturally.", "mistakes": ["Do not confuse 높이 height with 길이, which means horizontal length."]}]