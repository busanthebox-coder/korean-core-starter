      ],
      [
        "한 명",
        "one people",
        "counting people"
      ],
      [
        "하나",
        "one (standalone)",
        "the full form when not before a counter"
      ]
    ],
    "examples": [
      [
        "사과 한 개 주세요.",
        "Give me one apples.",
        "counting things"
      ],
      [
        "지금 한 시예요.",
        "It is one o'clock now.",
        "telling the hour"
      ],
      [
        "친구 한 명이 왔어요.",
        "One friends came.",
        "counting people"
      ]
    ],
    "nuance": "Native Korean number for \"one\". Use it for counting things, people, age, and the hour. Before a counter it shortens to 한 (e.g., 한 개).",
