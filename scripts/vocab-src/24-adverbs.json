[{"kind":"adverb","hangul":"자주","english":"often","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["자주 가요","I go often","before the verb"],["자주 만나요","we meet often","frequency adverb"],["자주 먹어요","I eat it often","placed before verb"],["자주 안 와요","I do not come often","before negative"]],"examples":[["저는 카페에 자주 가요.","I often go to the cafe.","자주 before 가요"],["친구를 자주 만나요.","I meet my friend often.","자주 before 만나요"],["요즘 운동을 자주 해요.","These days I often exercise.","자주 before 해요"]],"nuance":"자주 means often and goes right before the verb it modifies. It describes how frequently an action happens, not how well.","mistakes":["Putting 자주 after the verb"]},
{"kind":"adverb","hangul":"가끔","english":"sometimes","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["가끔 봐요","I see it sometimes","before the verb"],["가끔 가요","I sometimes go","frequency adverb"],["가끔 울어요","I cry sometimes","placed before verb"],["가끔 생각해요","I think of it sometimes","before verb"]],"examples":[["저는 가끔 영화를 봐요.","I sometimes watch movies.","가끔 before 봐요"],["가끔 부모님께 전화해요.","I sometimes call my parents.","가끔 before 전화해요"],["주말에 가끔 늦게 일어나요.","On weekends I sometimes get up late.","가끔 before 일어나요"]],"nuance":"가끔 means sometimes or once in a while and sits before the verb. It is less frequent than 자주 but more than never.","mistakes":["Confusing 가끔 with 자주"]},
{"kind":"adverb","hangul":"항상","english":"always","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["항상 웃어요","you always smile","before the verb"],["항상 늦어요","he is always late","frequency adverb"],["항상 와요","she always comes","placed before verb"],["항상 도와줘요","they always help","before verb"]],"examples":[["언니는 항상 아침을 먹어요.","My sister always eats breakfast.","항상 before 먹어요"],["저는 항상 일찍 일어나요.","I always get up early.","항상 before 일어나요"],["그분은 항상 친절하게 말해요.","That person always speaks kindly.","항상 before 말해요"]],"nuance":"항상 means always and goes before the verb to show an action happens every time without exception. It is stronger than 보통.","mistakes":["Saying 항상 for occasional actions"]},
{"kind":"adverb","hangul":"보통","english":"usually","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["보통 가요","I usually go","before the verb"],["보통 자요","I usually sleep","frequency adverb"],["보통 먹어요","I usually eat","placed before verb"],["보통 걸어요","I usually walk","before verb"]],"examples":[["저는 보통 일곱 시에 일어나요.","I usually get up at seven.","보통 before 일어나요"],["주말에는 보통 집에서 쉬어요.","On weekends I usually rest at home.","보통 before 쉬어요"],["점심은 보통 회사에서 먹어요.","I usually eat lunch at work.","보통 before 먹어요"]],"nuance":"보통 means usually and describes what normally happens. Placed before the verb, it shows a regular habit but allows for exceptions.","mistakes":["Using 보통 to mean always"]},
{"kind":"adverb","hangul":"일찍","english":"early","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-ending-want"],"usage":[["일찍 자요","I sleep early","before the verb"],["일찍 와요","come early","time adverb"],["일찍 일어나요","I get up early","placed before verb"],["일찍 가요","I go early","before verb"]],"examples":[["저는 보통 일찍 자요.","I usually sleep early.","일찍 before 자요"],["내일은 일찍 일어나고 싶어요.","Tomorrow I want to get up early.","일찍 before 일어나고"],["회사에 일찍 도착했어요.","I arrived at work early.","일찍 before 도착했어요"]],"nuance":"일찍 means early in time and goes before the verb. It describes doing something sooner than usual, the opposite of 늦게.","mistakes":["Confusing 일찍 with 빨리 (quickly)"]},
{"kind":"adverb","hangul":"늦게","english":"late","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["늦게 자요","I sleep late","before the verb"],["늦게 와요","you come late","time adverb"],["늦게 일어나요","I get up late","placed before verb"],["늦게 먹어요","I eat late","before verb"]],"examples":[["어제 너무 늦게 잤어요.","I slept too late yesterday.","늦게 before 잤어요"],["주말에는 늦게 일어나요.","On weekends I get up late.","늦게 before 일어나요"],["친구가 약속에 늦게 왔어요.","My friend came late to the meeting.","늦게 before 왔어요"]],"nuance":"늦게 means late and goes before the verb. It is the adverb form of 늦다 and is the opposite of 일찍.","mistakes":["Saying 늦어 instead of 늦게"]},
{"kind":"adverb","hangul":"먼저","english":"first","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["먼저 가요","I go first","before the verb"],["먼저 해요","do it first","order adverb"],["먼저 먹어요","eat first","placed before verb"],["먼저 씻어요","I wash up first","before verb"]],"examples":[["저 먼저 갈게요.","I will go first.","먼저 before 갈게요"],["손을 먼저 씻어요.","Wash your hands first.","먼저 before 씻어요"],["숙제를 먼저 하고 놀아요.","I do homework first and then play.","먼저 before 하고"]],"nuance":"먼저 means first or beforehand and goes before the verb. It shows which action comes earlier in order or time.","mistakes":["Mixing up 먼저 with 처음 (the first time)"]},
{"kind":"adverb","hangul":"벌써","english":"already","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["벌써 왔어요","you came already","before the verb"],["벌써 끝났어요","it ended already","time adverb"],["벌써 먹었어요","I already ate","placed before verb"],["벌써 갔어요","they already left","before verb"]],"examples":[["벌써 점심을 먹었어요.","I already ate lunch.","벌써 before 먹었어요"],["기차가 벌써 떠났어요.","The train already left.","벌써 before 떠났어요"],["숙제를 벌써 다 했어요.","I already finished the homework.","벌써 before 했어요"]],"nuance":"벌써 means already and goes before the verb. It shows surprise that something happened sooner than expected, often with past tense.","mistakes":["Using 벌써 with future actions"]},
{"kind":"adverb","hangul":"아직","english":"still; yet","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["아직 자요","they are still sleeping","before the verb"],["아직 안 왔어요","not here yet","with negative"],["아직 일해요","I still work","placed before verb"],["아직 몰라요","I do not know yet","before verb"]],"examples":[["저는 아직 학생이에요.","I am still a student.","아직 before the noun phrase"],["밥을 아직 안 먹었어요.","I have not eaten yet.","아직 before 안 먹었어요"],["동생이 아직 자고 있어요.","My sibling is still sleeping.","아직 before 자고"]],"nuance":"아직 means still or not yet and goes before the verb. With a negative verb it means not yet, showing something has not happened.","mistakes":["Confusing 아직 with 벌써"]},
{"kind":"adverb","hangul":"또","english":"again; also","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["또 와요","come again","before the verb"],["또 봐요","see you again","repetition adverb"],["또 먹어요","I eat it again","placed before verb"],["또 실수해요","I make a mistake again","before verb"]],"examples":[["내일 또 만나요.","Let us meet again tomorrow.","또 before 만나요"],["그 영화를 또 봤어요.","I watched that movie again.","또 before 봤어요"],["비가 또 와요.","It is raining again.","또 before 와요"]],"nuance":"또 means again or also and goes before the verb. It shows an action repeats, and is common in friendly goodbyes like 또 봐요.","mistakes":["Mixing up 또 with 다시 (once more)"]},
{"kind":"adverb","hangul":"너무","english":"too much","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["너무 많아요","there is too much","degree adverb"],["너무 먹어요","I eat too much","before verb"],["너무 좋아해요","I like it too much","placed before verb"],["너무 비싸요","it is too expensive","before adjective"]],"examples":[["어제 너무 많이 먹었어요.","I ate too much yesterday.","너무 before 많이"],["이 가방을 너무 좋아해요.","I like this bag too much.","너무 before 좋아해요"],["일이 너무 많아요.","There is too much work.","너무 intensifies the verb"]],"nuance":"너무 means too much or excessively and goes before the verb or adjective. In casual speech it can also mean very in a positive way.","mistakes":["Overusing 너무 where 아주 fits better"]},
{"kind":"adverb","hangul":"아주","english":"very","topic":"daily-life","chapterIds":["chapter-05","chapter-11"],"grammarIds":["grammar-particle-eun-neun","grammar-connector-and"],"usage":[["아주 좋아요","it is very good","degree adverb"],["아주 잘해요","you do it very well","before verb"],["아주 좋아해요","I like it very much","placed before verb"],["아주 맛있어요","it is very tasty","before adjective"]],"examples":[["저는 한국 음식을 아주 좋아해요.","I like Korean food very much.","아주 before 좋아해요"],["그분은 노래를 아주 잘해요.","That person sings very well.","아주 before 잘해요"],["오늘 날씨가 아주 좋아요.","The weather is very nice today.","아주 intensifies the verb"]],"nuance":"아주 means very and goes before the verb or adjective to strengthen it. Unlike 너무, it is neutral and does not imply excess.","mistakes":["Using 아주 only for negative degrees"]}]