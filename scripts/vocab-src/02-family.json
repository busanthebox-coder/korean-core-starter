[{"kind":"noun","hangul":"가족","english":"family","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eun-neun"],"usage":[["우리 가족","my family","우리 means our"],["가족이 많아요","family is big","many members"],["가족 사진","family photo","photo of family"],["가족과 함께","with family","함께 means together"]],"examples":[["우리 가족은 네 명이에요.","My family has four people.","명 counts people"],["저는 가족을 사랑해요.","I love my family.","사랑하다 means love"],["주말에 가족과 같이 밥을 먹어요.","On weekends I eat with family.","같이 means together"]],"nuance":"가족 refers to the whole family unit, not one person. Koreans often say 우리 가족 even when meaning my own family.","mistakes":["Using 가족 to mean a single relative instead of 가족 구성원"]},{"kind":"noun","hangul":"부모님","english":"parents","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-ege-hante"],"usage":[["우리 부모님","my parents","honorific form"],["부모님이 계세요","parents are present","계시다 is honorific"],["부모님께","to parents","께 is honorific"],["부모님 댁","parents home","댁 is honorific"]],"examples":[["저는 부모님과 같이 살아요.","I live with my parents.","살다 means live"],["부모님께 전화를 해요.","I call my parents.","께 shows respect"],["부모님은 부산에 계세요.","My parents are in Busan.","계세요 is honorific"]],"nuance":"부모님 already includes the honorific 님, so it is the polite default. Use honorific verbs like 계시다 with it.","mistakes":["Saying 부모 alone, which sounds blunt without 님"]},{"kind":"noun","hangul":"엄마","english":"mom","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eul-reul"],"usage":[["우리 엄마","my mom","우리 means our"],["엄마가 좋아요","I like mom","casual warm word"],["엄마를 도와요","help mom","돕다 means help"],["엄마한테","to mom","한테 is casual"]],"examples":[["우리 엄마는 요리를 잘해요.","My mom cooks well.","잘하다 means do well"],["저는 엄마를 정말 좋아해요.","I really like my mom.","정말 means really"],["엄마한테 선물을 줬어요.","I gave mom a gift.","줬어요 means gave"]],"nuance":"엄마 is the warm, affectionate word for mother used at home. The more formal word is 어머니, used in polite settings.","mistakes":["Using 엄마 in very formal speech instead of 어머니"]},{"kind":"noun","hangul":"아빠","english":"dad","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eul-reul"],"usage":[["우리 아빠","my dad","우리 means our"],["아빠가 멋있어요","dad is cool","warm casual word"],["아빠를 닮았어요","resemble dad","닮다 means resemble"],["아빠한테","to dad","한테 is casual"]],"examples":[["우리 아빠는 회사에 다녀요.","My dad works at a company.","다니다 means attend"],["저는 아빠를 많이 닮았어요.","I look a lot like my dad.","닮다 means resemble"],["아빠하고 같이 운동해요.","I exercise with my dad.","하고 means with"]],"nuance":"아빠 is the affectionate home word for father. In formal situations Koreans switch to 아버지 instead.","mistakes":["Using 아빠 in business or formal contexts instead of 아버지"]},{"kind":"noun","hangul":"형","english":"older brother (male speaker)","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-ege-hante"],"usage":[["우리 형","my older brother","male speaker only"],["형이 있어요","I have an older brother","있다 means have"],["형한테","to older brother","한테 is casual"],["친형","biological brother","친 means real"]],"examples":[["저는 형이 한 명 있어요.","I have one older brother.","명 counts people"],["형하고 같이 게임을 해요.","I play games with my brother.","하고 means with"],["형이 저보다 키가 커요.","My brother is taller than me.","보다 means than"]],"nuance":"형 is used only by a male speaker for an older brother. A female speaker says 오빠 instead, so the word reveals the speaker gender.","mistakes":["A female speaker using 형 instead of 오빠"]},{"kind":"noun","hangul":"누나","english":"older sister (male speaker)","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-ege-hante"],"usage":[["우리 누나","my older sister","male speaker only"],["누나가 있어요","I have an older sister","있다 means have"],["누나한테","to older sister","한테 is casual"],["친누나","biological sister","친 means real"]],"examples":[["저는 누나가 두 명 있어요.","I have two older sisters.","명 counts people"],["누나가 저를 도와줘요.","My older sister helps me.","도와주다 means help"],["누나하고 카페에 가요.","I go to a cafe with my sister.","하고 means with"]],"nuance":"누나 is used only by a male speaker for an older sister. A female speaker says 언니 instead, so the choice signals the speaker is male.","mistakes":["A female speaker using 누나 instead of 언니"]},{"kind":"noun","hangul":"오빠","english":"older brother (female speaker)","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-ege-hante"],"usage":[["우리 오빠","my older brother","female speaker only"],["오빠가 있어요","I have an older brother","있다 means have"],["오빠한테","to older brother","한테 is casual"],["친오빠","biological brother","친 means real"]],"examples":[["저는 오빠가 한 명 있어요.","I have one older brother.","명 counts people"],["오빠가 저를 데리러 와요.","My brother comes to pick me up.","데리러 means to fetch"],["오빠하고 영화를 봐요.","I watch a movie with my brother.","하고 means with"]],"nuance":"오빠 is used only by a female speaker for an older brother. A male speaker says 형 instead, so the word marks the speaker as female.","mistakes":["A male speaker using 오빠 instead of 형"]},{"kind":"noun","hangul":"언니","english":"older sister (female speaker)","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-ege-hante"],"usage":[["우리 언니","my older sister","female speaker only"],["언니가 있어요","I have an older sister","있다 means have"],["언니한테","to older sister","한테 is casual"],["친언니","biological sister","친 means real"]],"examples":[["저는 언니가 두 명 있어요.","I have two older sisters.","명 counts people"],["언니가 옷을 빌려줘요.","My sister lends me clothes.","빌려주다 means lend"],["언니하고 쇼핑을 해요.","I go shopping with my sister.","하고 means with"]],"nuance":"언니 is used only by a female speaker for an older sister. A male speaker says 누나 instead, so the word signals the speaker is female.","mistakes":["A male speaker using 언니 instead of 누나"]},{"kind":"noun","hangul":"동생","english":"younger sibling","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eul-reul"],"usage":[["우리 동생","my younger sibling","male or female"],["동생이 있어요","I have a younger sibling","있다 means have"],["남동생","younger brother","남 means male"],["여동생","younger sister","여 means female"]],"examples":[["저는 동생이 한 명 있어요.","I have one younger sibling.","명 counts people"],["동생을 자주 돌봐요.","I often take care of my sibling.","돌보다 means care for"],["남동생이 키가 커요.","My younger brother is tall.","키가 크다 means tall"]],"nuance":"동생 works for a younger brother or sister regardless of speaker gender. Add 남 or 여 to specify the sibling sex when needed.","mistakes":["Assuming 동생 means only younger brother"]},{"kind":"noun","hangul":"남편","english":"husband","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eun-neun"],"usage":[["우리 남편","my husband","우리 common here"],["남편이 있어요","I have a husband","있다 means have"],["남편하고","with husband","하고 means with"],["남편 회사","husband company","his workplace"]],"examples":[["우리 남편은 선생님이에요.","My husband is a teacher.","이에요 means is"],["남편하고 같이 여행을 가요.","I travel with my husband.","하고 means with"],["남편이 요리를 잘해요.","My husband cooks well.","잘하다 means do well"]],"nuance":"남편 means your own or someone else husband in plain speech. To honor another person husband politely, Koreans say 남편분.","mistakes":["Using 남편 to mean boyfriend instead of 남자친구"]},{"kind":"noun","hangul":"아내","english":"wife","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eun-neun"],"usage":[["우리 아내","my wife","우리 common here"],["아내가 있어요","I have a wife","있다 means have"],["아내하고","with wife","하고 means with"],["아내 생일","wife birthday","her birthday"]],"examples":[["우리 아내는 간호사예요.","My wife is a nurse.","예요 means is"],["아내하고 같이 장을 봐요.","I go grocery shopping with my wife.","장을 보다 means shop"],["아내가 책을 좋아해요.","My wife likes books.","좋아하다 means like"]],"nuance":"아내 is the standard word for ones own wife. The word 와이프 is also common in casual speech, while 부인 politely refers to another man wife.","mistakes":["Using 아내 to mean girlfriend instead of 여자친구"]},{"kind":"noun","hangul":"아이","english":"child","topic":"daily-life","chapterIds":["chapter-04"],"grammarIds":["grammar-particle-i-ga","grammar-particle-eul-reul"],"usage":[["우리 아이","my child","우리 means our"],["아이가 있어요","I have a child","있다 means have"],["아이 두 명","two children","명 counts people"],["아이를 키워요","raise a child","키우다 means raise"]],"examples":[["저는 아이가 한 명 있어요.","I have one child.","명 counts people"],["아이가 학교에 가요.","My child goes to school.","가다 means go"],["아이를 사랑해요.","I love my child.","사랑하다 means love"]],"nuance":"아이 means a child in general and is often shortened to 애 in casual speech. It can mean ones own kid or any young child by context.","mistakes":["Confusing 아이 with 아기, which means baby"]}]
