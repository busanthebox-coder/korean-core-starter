[{"kind":"noun","hangul":"바나나","english":"banana","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["바나나를 먹어요","I eat a banana","object marker 를"],["바나나가 노래요","the banana is yellow","subject marker 가"],["바나나를 좋아해요","I like bananas","좋아해요 means like"],["바나나 한 개","one banana","개 counts items"]],"examples":[["저는 아침마다 바나나를 먹어요.","I eat a banana every morning.","daily habit"],["이 바나나가 아주 달아요.","This banana is very sweet.","describing taste"],["바나나 두 개 주세요.","Give me two bananas, please.","at the store"]],"nuance":"바나나 is a foreign loanword written in hangul, and Koreans pronounce every syllable evenly. It is one of the most common everyday fruits.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"딸기","english":"strawberry","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["딸기를 먹어요","I eat strawberries","object marker 를"],["딸기가 빨개요","the strawberry is red","subject marker 가"],["딸기를 좋아해요","I like strawberries","좋아해요 means like"],["딸기 한 개","one strawberry","개 counts items"]],"examples":[["저는 딸기를 정말 좋아해요.","I really like strawberries.","preference"],["이 딸기가 아주 달아요.","This strawberry is very sweet.","describing taste"],["봄에 딸기를 많이 먹어요.","I eat many strawberries in spring.","seasonal fruit"]],"nuance":"딸기 is a popular spring fruit and also a common flavor for milk and desserts. Saying 딸기 우유 means strawberry milk, not real berries.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"포도","english":"grapes","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["포도를 먹어요","I eat grapes","object marker 를"],["포도가 달아요","the grapes are sweet","subject marker 가"],["포도를 좋아해요","I like grapes","좋아해요 means like"],["포도 한 송이","one bunch of grapes","송이 counts bunches"]],"examples":[["저는 포도를 자주 먹어요.","I eat grapes often.","eating habit"],["이 포도가 정말 달아요.","These grapes are really sweet.","describing taste"],["가을에 포도를 많이 먹어요.","I eat many grapes in autumn.","seasonal fruit"]],"nuance":"포도 is treated as one group word, so you do not add a plural ending even for a whole bunch. To count bunches Koreans use the counter 송이.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"수박","english":"watermelon","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["수박을 먹어요","I eat watermelon","object marker 을"],["수박이 커요","the watermelon is big","subject marker 이"],["수박을 좋아해요","I like watermelon","좋아해요 means like"],["수박 한 통","one whole watermelon","통 counts whole ones"]],"examples":[["저는 여름에 수박을 먹어요.","I eat watermelon in summer.","seasonal fruit"],["이 수박이 아주 시원해요.","This watermelon is very refreshing.","describing taste"],["수박 한 통 주세요.","Give me one watermelon, please.","at the store"]],"nuance":"수박 is the big summer fruit eaten cold in slices to cool down. A whole one is counted with 통, while a cut piece uses 조각.","mistakes":["Using 개 instead of 통 for a whole watermelon"]},
{"kind":"noun","hangul":"귤","english":"tangerine","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["귤을 먹어요","I eat a tangerine","object marker 을"],["귤이 달아요","the tangerine is sweet","subject marker 이"],["귤을 좋아해요","I like tangerines","좋아해요 means like"],["귤 한 개","one tangerine","개 counts items"]],"examples":[["저는 겨울에 귤을 많이 먹어요.","I eat many tangerines in winter.","seasonal fruit"],["이 귤이 정말 달아요.","This tangerine is really sweet.","describing taste"],["귤 다섯 개 주세요.","Give me five tangerines, please.","at the store"]],"nuance":"귤 is a small easy peel citrus eaten often in winter, especially from Jeju Island. People peel it by hand and eat it as a cozy snack.","mistakes":["Confusing 귤 the tangerine with 오렌지 the orange"]},
{"kind":"noun","hangul":"토마토","english":"tomato","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["토마토를 먹어요","I eat a tomato","object marker 를"],["토마토가 빨개요","the tomato is red","subject marker 가"],["토마토를 좋아해요","I like tomatoes","좋아해요 means like"],["토마토 한 개","one tomato","개 counts items"]],"examples":[["저는 토마토를 자주 먹어요.","I eat tomatoes often.","eating habit"],["이 토마토가 아주 신선해요.","This tomato is very fresh.","describing freshness"],["토마토 세 개 주세요.","Give me three tomatoes, please.","at the store"]],"nuance":"토마토 is a loanword spelled the same backward and forward in hangul. Koreans often eat it as a fruit or in salads rather than only cooked.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"당근","english":"carrot","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["당근을 먹어요","I eat a carrot","object marker 을"],["당근이 달아요","the carrot is sweet","subject marker 이"],["당근을 싫어해요","I dislike carrots","싫어해요 means dislike"],["당근 한 개","one carrot","개 counts items"]],"examples":[["저는 당근을 매일 먹어요.","I eat carrots every day.","healthy habit"],["이 당근이 아주 신선해요.","This carrot is very fresh.","at the store"],["당근 두 개 주세요.","Give me two carrots, please.","shopping"]],"nuance":"당근 is a common orange vegetable used in many side dishes and soups. In slang 당근 also means of course, but here it is the vegetable.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"양파","english":"onion","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["양파를 먹어요","I eat onion","object marker 를"],["양파가 매워요","the onion is spicy","subject marker 가"],["양파를 썰어요","I slice an onion","썰어요 means slice"],["양파 한 개","one onion","개 counts items"]],"examples":[["저는 요리에 양파를 자주 넣어요.","I often add onion to cooking.","cooking ingredient"],["이 양파가 너무 매워요.","This onion is too spicy.","describing taste"],["양파 두 개 주세요.","Give me two onions, please.","at the store"]],"nuance":"양파 is a basic cooking vegetable added to almost every Korean dish. Cutting it can make your eyes water, so people often rinse it first.","mistakes":["Confusing 양파 the onion with 파 the green onion"]},
{"kind":"noun","hangul":"감자","english":"potato","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["감자를 먹어요","I eat a potato","object marker 를"],["감자가 맛있어요","the potato is tasty","subject marker 가"],["감자를 삶아요","I boil potatoes","삶아요 means boil"],["감자 한 개","one potato","개 counts items"]],"examples":[["저는 감자를 자주 삶아 먹어요.","I often boil and eat potatoes.","cooking habit"],["이 감자가 아주 맛있어요.","This potato is very tasty.","describing taste"],["감자 세 개 주세요.","Give me three potatoes, please.","at the store"]],"nuance":"감자 is a starchy vegetable boiled, fried, or added to soups and stews. Do not confuse it with 고구마, the sweeter orange sweet potato.","mistakes":["Confusing 감자 the potato with 고구마 sweet potato"]},
{"kind":"noun","hangul":"오이","english":"cucumber","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["오이를 먹어요","I eat a cucumber","object marker 를"],["오이가 시원해요","the cucumber is refreshing","subject marker 가"],["오이를 좋아해요","I like cucumbers","좋아해요 means like"],["오이 한 개","one cucumber","개 counts items"]],"examples":[["저는 여름에 오이를 자주 먹어요.","I eat cucumbers often in summer.","refreshing snack"],["이 오이가 아주 시원해요.","This cucumber is very refreshing.","describing taste"],["오이 두 개 주세요.","Give me two cucumbers, please.","at the store"]],"nuance":"오이 is a crisp watery vegetable eaten raw or made into a side dish. Some people dislike its smell, so it is a common like or dislike topic.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"마늘","english":"garlic","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["마늘을 먹어요","I eat garlic","object marker 을"],["마늘이 매워요","the garlic is pungent","subject marker 이"],["마늘을 넣어요","I add garlic","넣어요 means add"],["마늘 한 개","one garlic clove","개 counts items"]],"examples":[["한국 음식에는 마늘을 많이 넣어요.","Korean food uses a lot of garlic.","common ingredient"],["이 마늘이 너무 매워요.","This garlic is too pungent.","describing taste"],["마늘을 조금만 넣어 주세요.","Please add only a little garlic.","polite request"]],"nuance":"마늘 is used in almost every Korean dish and gives food its strong flavor. Koreans eat a lot of it, raw or cooked, more than many cultures.","mistakes":["Adding a plural ending like the English word"]},
{"kind":"noun","hangul":"배추","english":"napa cabbage","topic":"food","chapterIds":["chapter-07"],"grammarIds":["grammar-particle-eul-reul","grammar-particle-i-ga"],"usage":[["배추를 사요","I buy napa cabbage","사요 means buy"],["배추가 싱싱해요","the cabbage is fresh","subject marker 가"],["배추로 김치를 만들어요","I make kimchi with cabbage","로 means with"],["배추 한 포기","one head of cabbage","포기 counts heads"]],"examples":[["저는 배추로 김치를 만들어요.","I make kimchi with napa cabbage.","main ingredient"],["이 배추가 아주 싱싱해요.","This napa cabbage is very fresh.","at the market"],["배추 한 포기 주세요.","Give me one cabbage, please.","at the store"]],"nuance":"배추 is the long leafy cabbage used as the main ingredient for kimchi. A whole head is counted with 포기, not the usual 개 counter.","mistakes":["Using 개 instead of 포기 for whole cabbage"]}]
