[{"kind": "noun", "hangul": "기쁨", "english": "joy", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["기쁨이 커요", "The joy is big", "subject marker after a vowel"], ["기쁨을 느껴요", "I feel joy", "object marker for the feeling"], ["큰 기쁨이에요", "It is a great joy", "polite ending after a noun"], ["기쁨의 순간", "a moment of joy", "possessive linking two nouns"]], "examples": [["오늘 정말 큰 기쁨을 느꼈어요", "I felt great joy today", "past tense of the verb"], ["가족이 제 기쁨이에요", "My family is my joy", "subject after a final consonant"], ["작은 기쁨이 모여요", "Small joys gather together", "everyday positive nuance"]], "nuance": "Joy is a warm inner happiness from good things, deeper than a passing smile or simple amusement.", "mistakes": ["Do not confuse joy with the verb to be glad."]}, {"kind": "noun", "hangul": "슬픔", "english": "sadness", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["슬픔이 와요", "Sadness comes", "subject marker after a vowel"], ["슬픔을 느껴요", "I feel sadness", "object marker for the feeling"], ["깊은 슬픔이에요", "It is a deep sadness", "polite ending after a noun"], ["슬픔의 눈물", "tears of sadness", "possessive linking two nouns"]], "examples": [["친구가 떠나서 슬픔을 느껴요", "I feel sadness because my friend left", "reason clause with the verb"], ["그 슬픔이 아직 남아요", "That sadness still remains", "subject after a final consonant"], ["슬픔도 시간이 지나가요", "Even sadness passes with time", "gentle comforting nuance"]], "nuance": "Sadness is a heavy quiet sorrow inside the heart, often from loss, parting, or disappointment.", "mistakes": ["Do not use this noun where the adjective sad fits."]}, {"kind": "noun", "hangul": "분노", "english": "anger", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["분노가 생겨요", "Anger arises", "subject marker after a vowel"], ["분노를 느껴요", "I feel anger", "object marker for the feeling"], ["큰 분노예요", "It is great anger", "polite ending after a noun"], ["분노의 표정", "an expression of anger", "possessive linking two nouns"]], "examples": [["거짓말에 분노를 느꼈어요", "I felt anger at the lie", "past tense of the verb"], ["그 분노가 너무 강해요", "That anger is too strong", "subject after a final consonant"], ["분노를 참기 어려워요", "It is hard to hold back anger", "describing self control"]], "nuance": "Anger is a strong burning emotion against unfairness or harm, heavier and more formal than mild annoyance.", "mistakes": ["Do not mix this strong word with light irritation."]}, {"kind": "noun", "hangul": "두려움", "english": "fear", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["두려움이 들어요", "Fear sets in", "subject marker after a vowel"], ["두려움을 느껴요", "I feel fear", "object marker for the feeling"], ["큰 두려움이에요", "It is a great fear", "polite ending after a noun"], ["두려움의 대상", "the object of fear", "possessive linking two nouns"]], "examples": [["새 일에 두려움을 느껴요", "I feel fear about the new job", "topic of the fear"], ["그 두려움이 사라졌어요", "That fear disappeared", "subject after a final consonant"], ["두려움 없이 도전해요", "I try without fear", "encouraging brave nuance"]], "nuance": "Fear is a deep worried feeling about danger or the unknown, broader and more inner than sudden surprise.", "mistakes": ["Do not confuse fear with a sudden startled reaction."]}, {"kind": "noun", "hangul": "외로움", "english": "loneliness", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["외로움이 커요", "The loneliness is big", "subject marker after a vowel"], ["외로움을 느껴요", "I feel loneliness", "object marker for the feeling"], ["깊은 외로움이에요", "It is a deep loneliness", "polite ending after a noun"], ["외로움의 밤", "a night of loneliness", "possessive linking two nouns"]], "examples": [["혼자 살아서 외로움을 느껴요", "I feel loneliness living alone", "reason clause with the verb"], ["그 외로움이 점점 커져요", "That loneliness grows slowly", "subject after a final consonant"], ["외로움은 누구나 느껴요", "Everyone feels loneliness", "shared human nuance"]], "nuance": "Loneliness is the empty aching feeling of being alone or apart from others, even inside a crowd.", "mistakes": ["Do not confuse loneliness with simply being physically alone."]}, {"kind": "noun", "hangul": "그리움", "english": "longing", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["그리움이 밀려와요", "Longing rushes in", "subject marker after a vowel"], ["그리움을 느껴요", "I feel longing", "object marker for the feeling"], ["깊은 그리움이에요", "It is a deep longing", "polite ending after a noun"], ["그리움의 마음", "a heart of longing", "possessive linking two nouns"]], "examples": [["고향에 대한 그리움을 느껴요", "I feel longing for my hometown", "target with about phrase"], ["그 그리움이 더 깊어져요", "That longing grows deeper", "subject after a final consonant"], ["오래된 사진이 그리움을 줘요", "An old photo brings longing", "tender memory nuance"]], "nuance": "Longing is a warm wistful missing of someone or somewhere far away, mixing sweetness with quiet sorrow.", "mistakes": ["Do not confuse longing with the verb to miss."]}, {"kind": "noun", "hangul": "즐거움", "english": "enjoyment", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["즐거움이 가득해요", "It is full of enjoyment", "subject marker after a vowel"], ["즐거움을 느껴요", "I feel enjoyment", "object marker for the feeling"], ["큰 즐거움이에요", "It is a great enjoyment", "polite ending after a noun"], ["즐거움의 시간", "a time of enjoyment", "possessive linking two nouns"]], "examples": [["여행에서 즐거움을 느껴요", "I feel enjoyment on the trip", "source of the feeling"], ["그 즐거움이 오래 남아요", "That enjoyment lasts long", "subject after a final consonant"], ["요리도 큰 즐거움이에요", "Cooking is also a great enjoyment", "hobby nuance"]], "nuance": "Enjoyment is the lively fun pleasure from activities you like, more active and playful than calm inner joy.", "mistakes": ["Do not confuse enjoyment with the adjective fun."]}, {"kind": "noun", "hangul": "부끄러움", "english": "shyness", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["부끄러움이 많아요", "There is much shyness", "subject marker after a vowel"], ["부끄러움을 느껴요", "I feel shyness", "object marker for the feeling"], ["작은 부끄러움이에요", "It is a small shyness", "polite ending after a noun"], ["부끄러움의 표정", "an expression of shyness", "possessive linking two nouns"]], "examples": [["발표할 때 부끄러움을 느껴요", "I feel shyness when presenting", "time clause with the verb"], ["그 부끄러움이 얼굴에 보여요", "That shyness shows on the face", "subject after a final consonant"], ["부끄러움 없이 말해요", "I speak without shyness", "growing confidence nuance"]], "nuance": "Shyness is the warm self conscious feeling of embarrassment before others, milder than deep shame or guilt.", "mistakes": ["Do not confuse shyness with serious moral shame."]}, {"kind": "noun", "hangul": "용기", "english": "courage", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["용기가 필요해요", "Courage is needed", "subject marker after a vowel"], ["용기를 내요", "I summon courage", "object marker with the verb"], ["큰 용기예요", "It is great courage", "polite ending after a noun"], ["용기의 한 걸음", "one step of courage", "possessive linking two nouns"]], "examples": [["새 일을 시작할 용기를 내요", "I find courage to start new work", "purpose with the verb"], ["그 용기가 정말 멋져요", "That courage is really cool", "subject after a final consonant"], ["용기를 주셔서 고마워요", "Thank you for giving courage", "gratitude nuance"]], "nuance": "Courage is the brave inner strength to face fear or hard things, a positive trait people admire and praise.", "mistakes": ["Do not confuse courage with reckless or careless behavior."]}, {"kind": "noun", "hangul": "희망", "english": "hope", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["희망이 있어요", "There is hope", "subject marker after a vowel"], ["희망을 가져요", "I hold hope", "object marker with the verb"], ["큰 희망이에요", "It is a great hope", "polite ending after a noun"], ["희망의 메시지", "a message of hope", "possessive linking two nouns"]], "examples": [["내일에 대한 희망을 가져요", "I hold hope for tomorrow", "target with about phrase"], ["그 희망이 저를 움직여요", "That hope moves me", "subject after a final consonant"], ["작은 희망도 소중해요", "Even small hope is precious", "uplifting nuance"]], "nuance": "Hope is the bright forward looking wish that good things will come, giving comfort and strength in hard times.", "mistakes": ["Do not confuse hope with a simple short wish."]}, {"kind": "noun", "hangul": "추억", "english": "memory", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["추억이 많아요", "There are many memories", "subject marker after a vowel"], ["추억을 떠올려요", "I recall a memory", "object marker with the verb"], ["좋은 추억이에요", "It is a good memory", "polite ending after a noun"], ["추억의 장소", "a place of memories", "possessive linking two nouns"]], "examples": [["학교에서 추억을 많이 만들었어요", "I made many memories at school", "past tense of the verb"], ["그 추억이 아직 생생해요", "That memory is still vivid", "subject after a final consonant"], ["사진으로 추억을 남겨요", "I keep memories with photos", "keepsake nuance"]], "nuance": "A memory here means a treasured past experience you look back on fondly, warmer than a plain factual recollection.", "mistakes": ["Do not use this word for ordinary information you remember."]}, {"kind": "noun", "hangul": "감정", "english": "emotion", "topic": "daily-life", "chapterIds": ["chapter-11"], "grammarIds": ["grammar-particle-i-ga"], "usage": [["감정이 복잡해요", "The emotions are complicated", "subject marker after a vowel"], ["감정을 표현해요", "I express my emotions", "object marker with the verb"], ["솔직한 감정이에요", "It is an honest emotion", "polite ending after a noun"], ["감정의 변화", "a change of emotion", "possessive linking two nouns"]], "examples": [["저는 감정을 잘 표현해요", "I express my emotions well", "everyday self description"], ["그 감정이 오래 가요", "That emotion lasts long", "subject after a final consonant"], ["감정을 솔직하게 말해요", "I speak my emotions honestly", "open communication nuance"]], "nuance": "Emotion is the general word for any inner feeling such as joy, anger, or sadness, broader than one specific mood.", "mistakes": ["Do not confuse this general word with one single feeling."]}]