    "id": "pack-survival-basics",
    "title": "Survival Basics",
    "shortTitle": "Survival",
    "insertAfterChapter": 1,
    "order": 1,
    "goal": "Get through the first day politely before you can build long sentences.",
    "context": "These are ready-to-say chunks. Learn them as whole phrases first, then notice the grammar later.",
