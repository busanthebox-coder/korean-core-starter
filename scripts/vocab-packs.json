  {
    "id": "pack-reactions-agree",
    "title": "Agreeing & Understanding",
    "shortTitle": "Agree",
    "insertAfterChapter": 2,
    "order": 3,
    "goal": "Show you're listening — half of a real conversation is reacting, not producing new sentences.",
    "context": "These look interchangeable but are not: 맞아요 confirms a fact, 그러게요/그러니까요 agree with an opinion, 그렇군요 takes in something new.",
    "items": [
      {
        "entryHangul": "맞아요",
        "note": "that is right — confirming a fact"
      },
      {
        "entryHangul": "그러게요",
        "note": "you said it — soft, shared agreement"
      },
      {
        "entryHangul": "그러니까요",
        "note": "exactly, that is my point — strong agreement"
      },
      {
        "entryHangul": "그렇군요",
        "note": "ah, I see — taking in new information"
      },
      {
        "entryHangul": "저도요",
        "note": "me too — borrows their verb, so it works anywhere"
      },
      {
        "entryHangul": "그런 것 같아요",
        "note": "I think so too — hedged agreement"
      },
      {
        "entryHangul": "다행이네요",
        "note": "what a relief — only after you were worried"
      },
      {
        "entryHangul": "잘됐네요",
        "note": "that worked out well — the situation, not their achievement"
      },
      {
        "entryHangul": "그렇죠",
        "note": "right? — inviting them to agree with you"
      },
      {
        "entryHangul": "알겠어요",
        "note": "got it — you've understood and will act on it"
      }
    ]
  },
  {
    "id": "pack-reactions-surprise",
    "title": "Reacting & Surprise",
    "shortTitle": "React",
    "insertAfterChapter": 7,
    "order": 4,
    "goal": "React like a person, not a textbook — the difference between a chat that dies and one that keeps going.",
    "context": "진짜요? and 정말요? both mean 'really?' — 진짜요? is warmer, 정말요? is the safe neutral pick.",
    "items": [
      {
        "entryHangul": "진짜요?",
        "note": "really? — warm, spontaneous check"
      },
      {
        "entryHangul": "정말요?",
        "note": "really? — neutral, safe in any register"
      },
      {
        "entryHangul": "아 그래요?",
        "note": "oh yeah? — mild surprise, invites more"
      },
      {
        "entryHangul": "헐",
        "note": "whoa — shock, style-neutral"
      },
      {
        "entryHangul": "대박",
        "note": "no way / amazing — big reaction"
      },
      {
        "entryHangul": "설마",
        "note": "surely not — disbelief"
      },
      {
        "entryHangul": "어머",
        "note": "oh my — softer surprise"
      },
      {
        "entryHangul": "아 맞다",
        "note": "oh right! — something of your own comes back to you"
      },
      {
        "entryHangul": "말도 안 돼",
        "note": "no way — strong disbelief, style-neutral"
      },
      {
        "entryHangul": "어떡해요",
        "note": "oh no, what do we do — sympathy for bad news"
      }
    ]
  }
