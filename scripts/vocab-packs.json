        "note": "goodbye to someone leaving"
      },
      {
        "entryHangul": "안녕히 계세요",
        "note": "goodbye when you are leaving"
      },
      {
        "entryHangul": "여기요",
        "note": "call staff in a restaurant or cafe"
      },
      {
        "entryHangul": "잠깐만요"
