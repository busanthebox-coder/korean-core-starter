{
  "name": "korean-core-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-pwa.mjs && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:content": "node scripts/lint-content.mjs",
    "preflight": "npm run test && npm run build && npm run lint:content",
    "validate:contrast": "node scripts/validate-contrast-items.mjs",
    "validate:hanja": "node scripts/validate-hanja-roots.mjs",
    "validate:readers": "node scripts/validate-readers.mjs && node scripts/check-reader-coverage.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/svelte": "^5.2.1",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.1.1",
    "svelte": "^4.2.19",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "svelte-spa-router": "^4.0.1"
  }
}
